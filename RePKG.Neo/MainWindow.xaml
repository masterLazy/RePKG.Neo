<Window x:Class="RePKG.Neo.MainWindow" x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:captionButtons="clr-namespace:SuGarToolkit.WPF.Controls.CaptionButtons;assembly=SuGarToolkit.WPF.Controls.CaptionButtons"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:lazy="clr-namespace:LazyWpf;assembly=LazyWpf"
        xmlns:res="clr-namespace:RePKG.Neo.res"
        xmlns:local="clr-namespace:RePKG.Neo"
        d:DataContext="{d:DesignInstance Type=local:MainWindowVm}"
        mc:Ignorable="d"
        Title="RePKG.Neo"
        Height="600" Width="800" FontSize="13"
        MinHeight="550" MinWidth="900"
        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        WindowStartupLocation="CenterScreen"
        RenderOptions.BitmapScalingMode="HighQuality"
        StateChanged="Window_StateChanged" Loaded="Window_OnLoaded" Closed="Window_Closed">
    <WindowChrome.WindowChrome>
        <WindowChrome
            x:Name="WindowChrome"
            CaptionHeight="36"
            UseAeroCaptionButtons="False"
            IsHitTestVisibleInChrome="True"/>
    </WindowChrome.WindowChrome>
    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}" x:Name="LayoutRoot">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarArea" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <captionButtons:CaptionButtonBar
                    Grid.Column="1"
                    Height="36" />
            </Grid>

            <!--Window caption-->
            <Grid Height="36">
                <Image Height="18" Margin="16 8" Source="/res/icon.png"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Margin="45 8" Orientation="Horizontal">
                    <TextBlock FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Run>RePKG.Neo</Run>
                        <Run />
                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Text="{x:Static local:Log.VersionText}" />
                        <Run />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               Text="&#xE7BA;" Visibility="{Binding ErrorIconVisibility}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <TabControl Grid.Row="1" x:Name="TabControl">
                <TabItem IsEnabled="false" Background="Transparent"/>
                <TabItem IsSelected="True">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="5 0 5 0" MinWidth="60" Height="20">
                            <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE74B;" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBlock Text="Extract" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel Margin="12 6 12 12">
                        <!--Top panel-->
                        <DockPanel DockPanel.Dock="Top" Margin="0 0 0 12" LastChildFill="False">
                            <DockPanel.Resources>
                                <ResourceDictionary>
                                    <Style TargetType="lazy:Button">
                                        <Setter Property="DockPanel.Dock" Value="Left" />
                                        <Setter Property="Height" Value="40" />
                                        <Setter Property="ToolTipService.InitialShowDelay" Value="100" />
                                    </Style>
                                </ResourceDictionary>
                            </DockPanel.Resources>
                            <lazy:Button Icon="&#xE8E5;" Text="{x:Static res:Lang.Btn_AddFile}"
                                         IsEnabled="{Binding NotRunning}"
                                         x:Name="BtnAddFile" Click="BtnAddFile_Click" />

                            <lazy:Button Icon="&#xE8DA;" Text="{x:Static res:Lang.Btn_AddFolder}"
                                         IsEnabled="{Binding NotRunning}"
                                         x:Name="BtnAddFolder" Click="BtnAddFolder_Click"
                                         ToolTip="{x:Static res:Lang.Btn_AddFolder_ToolTip}"
                                         Margin="5 0 0 0" />

                            <lazy:Button Icon="&#xE74D;" IsEnabled="{Binding NotRunning}"
                                         x:Name="BtnClear" Click="BtnClear_Click"
                                         ToolTip="{x:Static res:Lang.Btn_Clear_ToolTip}"
                                         Margin="5 0 0 0" />

                            <Separator Margin="0 10" BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                <Separator.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </Separator.LayoutTransform>
                            </Separator>

                            <lazy:Button Icon="&#xE768;" Text="{x:Static res:Lang.Btn_StartExtract}"
                                         IsEnabled="{Binding CanStart}"
                                         x:Name="BtnStart" Click="BtnStart_Click"
                                         IsAccented="True" />

                            <lazy:Button Icon="&#xE769;" IsEnabled="{Binding IsRunning}"
                                         x:Name="BtnStop" Click="BtnStop_Click"
                                         ToolTip="{x:Static res:Lang.Btn_Stop_ToolTip}" Margin="5 0 0 0" />

                            <lazy:Button Icon="&#xE9E9;" Text="{x:Static res:Lang.Btn_Options}" DockPanel.Dock="Right"
                                         x:Name="BtnOptions" Click="BtnOptions_Click" />
                            <!--Options panel-->
                            <Popup x:Name="PopupOptions" AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=BtnOptions}"
                                   Placement="Bottom"
                                   MouseLeave="PopupOptions_MouseLeave">
                                <Popup.Resources>
                                    <!-- ReSharper disable once Xaml.RedundantResource -->
                                    <Storyboard x:Key="FadeInStoryboard">
                                        <DoubleAnimation Storyboard.TargetName="PopupBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.07" />
                                    </Storyboard>
                                    <!-- ReSharper disable once Xaml.RedundantResource -->
                                    <Storyboard x:Key="FadeOutStoryboard">
                                        <DoubleAnimation Storyboard.TargetName="PopupBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="0:0:0.07" />
                                    </Storyboard>
                                </Popup.Resources>
                                <Border x:Name="PopupBorder"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="8" Opacity="0">
                                    <StackPanel MaxWidth="220" IsEnabled="{Binding NotRunning}">
                                        <StackPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                            <Style TargetType="CheckBox"
                                                   BasedOn="{StaticResource DefaultCheckBoxStyle}">
                                                <Setter Property="Margin" Value="5" />
                                            </Style>
                                        </StackPanel.Resources>

                                        <CheckBox IsChecked="{Binding Options.AutoExtract}">
                                            <TextBlock Text="{x:Static res:Lang.Chk_AutoExtract}" />
                                        </CheckBox>

                                        <Separator Margin="5 0 5 0" />

                                        <CheckBox IsChecked="{Binding Options.CopyProject}">
                                            <TextBlock Text="{x:Static res:Lang.Chk_CopyProject}" />
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding Options.NoTexConvert}">
                                            <TextBlock Text="{x:Static res:Lang.Chk_NoTexConvert}" />
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding Options.NoRawTex}">
                                            <TextBlock Text="{x:Static res:Lang.Chk_NoRawTex}" />
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding Options.SingleDir}">
                                            <TextBlock Text="{x:Static res:Lang.Chk_SingleDir}" />
                                        </CheckBox>

                                        <Button Content="{x:Static res:Lang.Btn_ViewLog}" x:Name="BtnViewLog"
                                                Click="BtnViewLog_Click" Height="35" Margin="5 5 5 0"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Separator Margin="0 10" BorderBrush="{DynamicResource TextFillColorDisabledBrush}">
                                <Separator.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </Separator.LayoutTransform>
                            </Separator>

                            <TextBlock Text="{x:Static res:Lang.Lbl_OutputSuffix}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Options.OutputSuffix, Mode=TwoWay}" Margin="8 0 0 -3"
                                     Height="30" Width="120" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border CornerRadius="8" BorderThickness="1" AllowDrop="True" Drop="Border_Drop"
                                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}">
                            <ListView ItemsSource="{Binding Items}" x:Name="ListView"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.Style>
                                    <Style TargetType="ListView">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListView">
                                                    <Border>
                                                        <Grid>
                                                            <!-- Scroll-view area -->
                                                            <ScrollViewer>
                                                                <ItemsPresenter />
                                                            </ScrollViewer>

                                                            <!-- Empty hint layer (invisible for default) -->
                                                            <StackPanel x:Name="EmptyStateImage"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="Collapsed">
                                                                <TextBlock Text="&#xE7B8;"
                                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                           FontSize="50"
                                                                           Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                                                                <TextBlock Margin="20 0 0 0"
                                                                           Text="{x:Static res:Lang.EmptyState_Text}"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="28"
                                                                           Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Show hint when list is empty -->
                                                        <Trigger Property="HasItems" Value="False">
                                                            <Setter TargetName="EmptyStateImage" Property="Visibility"
                                                                    Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.Style>

                                <!--Item list-->
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel HorizontalAlignment="Stretch" LastChildFill="False">
                                            <DockPanel.Resources>
                                                <Style TargetType="lazy:Button">
                                                    <Setter Property="ToolTipService.InitialShowDelay" Value="100" />
                                                    <Setter Property="ToolTipService.Placement" Value="Bottom" />
                                                </Style>
                                            </DockPanel.Resources>
                                            <!--Progressbar-->
                                            <lazy:ProgBar DockPanel.Dock="Bottom" Height="4" Margin="-5 0"
                                                          Maximum="100" Value="{Binding Percent}"
                                                          FadeOutWhenComplete="True" />
                                            <!--Thumbnail-->
                                            <Image Source="{Binding Thumb}" DockPanel.Dock="Left" Width="48"
                                                   Height="48"
                                                   Margin="-5 5 5 5"
                                                   ToolTipService.InitialShowDelay="300">
                                                <Image.Clip>
                                                    <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,48,48" />
                                                </Image.Clip>
                                                <ToolTipService.ToolTip>
                                                    <Image VerticalAlignment="Center" HorizontalAlignment="Left"
                                                           Margin="0"
                                                           MaxHeight="100" MaxWidth="100" Source="{Binding Thumb}" />
                                                </ToolTipService.ToolTip>
                                            </Image>
                                            <!--Buttons at right-->
                                            <lazy:Button DockPanel.Dock="Right" Icon="&#xE894;"
                                                         ToolTip="{x:Static res:Lang.Btn_Remove_ToolTip}"
                                                         x:Name="BtnRemove" Click="BtnRemove_Click"
                                                         Height="40" HorizontalAlignment="Right" Visibility="Collapsed" />
                                            <lazy:Button DockPanel.Dock="Right" Icon="&#xEC50;"
                                                         ToolTip="{x:Static res:Lang.Btn_Reveal_ToolTip}"
                                                         x:Name="BtnReveal" Click="BtnReveal_Click" Margin="0 0 5 0"
                                                         Height="40" HorizontalAlignment="Right" Visibility="Collapsed" />
                                            <lazy:Button DockPanel.Dock="Right" Icon="&#xE786;" IsEnabled="{Binding IsWebviewReady, ElementName=Root}"
                                                         ToolTip="Preview (beta)"
                                                         x:Name="BtnPreview" Click="BtnPreview_OnClick" Margin="0 0 5 0"
                                                         Height="40" HorizontalAlignment="Right" Visibility="Collapsed" />
                                            <!--Infos-->
                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"
                                                        Margin="5 2.5 2.5 2.5"
                                                        HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" Margin="2.5">
                                                    <TextBlock Text="{Binding FileName}" />
                                                    <TextBlock Text="{Binding Title}" Margin="10 0 0 0"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="2.5">
                                                    <TextBlock Text="{Binding DisplayDir}" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding FileSize}" Margin="10 0 0 0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Text}" Margin="10 0 0 0" FontSize="12"
                                                               Foreground="{Binding TextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger
                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}"
                                                Value="True">
                                                <Setter TargetName="BtnRemove" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="BtnReveal" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="BtnPreview" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="TabViewer">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="5 0 5 0" MinWidth="60" Height="20">
                            <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE786;" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBlock Text="Preview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="12 6" Orientation="Horizontal">
                            <lazy:Button Icon="&#xE8DA;" Text="Open" Click="BtnOpenWallpaper_OnClick" Height="40" Margin="0 0 5 0"/>
                            <lazy:Button Icon="&#xE72C;" Text="Reload" Click="BtnRefreshWallpaper_OnClick" Height="40" Margin="0 0 5 0"/>
                            <lazy:Button Icon="&#xE894;" Click="BtnCloseWallpaper_OnClick" Height="40" Margin="0 0 5 0"/>
                            <TextBlock Text="{Binding Previewing}" Margin="10 0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <wv2:WebView2 x:Name="WebView"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>